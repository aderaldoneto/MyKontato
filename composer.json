{
    "name": "mykontato/app",
    "description": "Esqueleto da agenda telefônica MyKontato",
    "type": "project",
    "require": {
        "php": "^8.3",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^2.20",
        "symfony/cache": "^7.2",
        "symfony/dotenv": "^7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {}
    }
}
